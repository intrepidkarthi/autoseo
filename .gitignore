# secrets — never commit
.env
*.p8
client_secret*.json
token*.json
service-account*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# os
.DS_Store

# state/ is committed BY CI ONLY. Committing it from a workstation produced a rejected push,
# an unresolvable binary merge, and a lost commit — git cannot merge sqlite. The workflow is the
# single writer; locally the db is a throwaway cache rebuilt by `autoseo collect`.
state/autoseo.db

# sqlite side-files, raw media, scratch renders:
state/*.db-wal
state/*.db-shm
state/*.db-journal
state/media/
state/tmp/
