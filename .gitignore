# secrets — never commit
.env
*.p8
client_secret*.json
token*.json
service-account*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# os
.DS_Store

# The sqlite file is never committed by anyone. State lives in state/*.csv, which git can merge
# line by line and which shows up as a readable diff. The db is a local cache rebuilt by
# `autoseo restore`. Committing the binary cost a rejected push, two unresolvable conflicts, a
# commit recovered from the reflog, and a silently wiped backfill.
state/autoseo.db

# sqlite side-files, raw media, scratch renders:
state/*.db-wal
state/*.db-shm
state/*.db-journal
state/media/
state/tmp/

# rendered media is a build artifact, not state
state/media/
state/models/

# The duplication index is a cache, not state: 5.7 MB rebuilt from the live site on every run.
state/corpus_shingle.csv

# Generated by `autoseo dashboard` — regenerated from state/*.csv on demand, so committing it
# would churn a 22 KB blob on every run to store something the CSVs already contain.
state/dashboard.html

# Built by the pages workflow from state/*.csv; never committed.
public/
