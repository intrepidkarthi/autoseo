# Copy to .env for local runs. In CI these come from GitHub Environments.
# NEVER commit .env.

# --- environment: read -------------------------------------------------------
# Full contents of the service-account JSON (single line or multi-line both work)
GSC_SERVICE_ACCOUNT_JSON=
BING_WEBMASTER_API_KEY=

# Optional in Phase 0
GA4_PROPERTY_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=

# --- environment: compose ----------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- environment: publishing (Phase 3+) --------------------------------------
GH_DAILYVOX_TOKEN=
GH_SECRETS_TOKEN=
YT_CLIENT_SECRET_JSON=
YT_TOKEN_JSON=
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- settings ----------------------------------------------------------------
AUTOSEO_SITE=https://getdailyvox.com
# Leave blank to auto-detect the Search Console property (domain vs URL-prefix)
AUTOSEO_GSC_SITE_URL=
AUTOSEO_DB=state/autoseo.db
AUTOSEO_MONTHLY_CAP_USD=5.00
# URL Inspection calls per run. Site quota is 2000/day; stay well under.
AUTOSEO_INSPECT_LIMIT=200
# The channel uploads must land on (youtube.com/@dailyvoxapp). Checked against the token before
# every upload: videos.insert has no channel parameter, so a token minted against the wrong channel
# uploads successfully to the wrong place. Blank disables the check.
AUTOSEO_YT_CHANNEL_ID=UCr6TG_pDNzGdmHiCwgCk_-w
