# Copy to .env for local runs. In CI these come from GitHub Environments.
# NEVER commit .env.

# --- environment: read -------------------------------------------------------
# Full contents of the service-account JSON (single line or multi-line both work)
GSC_SERVICE_ACCOUNT_JSON=
BING_WEBMASTER_API_KEY=

# Optional in Phase 0
GA4_PROPERTY_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=

# --- environment: compose ----------------------------------------------------
# Reads the open web and runs the model. Deliberately holds nothing that can change the site.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- environment: publishing -------------------------------------------------
# The only credential that can change getdailyvox.com. Never set in the compose job.
GH_DAILYVOX_TOKEN=
GH_SECRETS_TOKEN=

# --- parked: video and social are switched off, the code stays ---------------
YT_CLIENT_SECRET_JSON=
YT_TOKEN_JSON=
PEXELS_API_KEY=

# --- settings ----------------------------------------------------------------
AUTOSEO_SITE=https://getdailyvox.com
# Leave blank to auto-detect the Search Console property (domain vs URL-prefix)
AUTOSEO_GSC_SITE_URL=
AUTOSEO_DB=state/autoseo.db
AUTOSEO_MONTHLY_CAP_USD=5.00
# URL Inspection calls per run. Site quota is 2000/day; stay well under.
AUTOSEO_INSPECT_LIMIT=200
# IndexNow submission key. Public by design — it is served at /<key>.txt to prove domain control.
# Leave blank to derive one deterministically from the site domain.
AUTOSEO_INDEXNOW_KEY=
# The kill switch. Any value other than empty/0/false stops both halves of the loop before they do
# anything. `state/PAUSE` does the same thing without an environment change.
AUTOSEO_PAUSE=
# Where the website lives inside the site repo. Leave blank: the path is probed on each run, which
# is what carried this loop across the move of `solyn/website/` to `website/` on 2026-08-14 without
# a code change. Set it only if the site lands somewhere neither candidate in
# publish/site.py:SITE_DIRS covers, as a same-day patch while that list is updated. A wrong value
# here writes a whole second, unserved website.
AUTOSEO_SITE_DIR=
# The channel uploads must land on (youtube.com/@dailyvoxapp). Checked against the token before
# every upload: videos.insert has no channel parameter, so a token minted against the wrong channel
# uploads successfully to the wrong place. Blank disables the check.
AUTOSEO_YT_CHANNEL_ID=UCr6TG_pDNzGdmHiCwgCk_-w
